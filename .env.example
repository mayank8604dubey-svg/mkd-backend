# MKD Messenger Backend Configuration
PORT=3000
NODE_ENV=development

# Database Connection
DATABASE_URL=postgresql://mkd_user:mkd_secure_password_2026@localhost:5432/mkd_messenger

# JWT Authentication
JWT_ACCESS_SECRET=mkd_jwt_access_super_secret_key_change_in_production_2026_xyz
JWT_REFRESH_SECRET=mkd_jwt_refresh_super_secret_key_change_in_production_2026_xyz
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# SMS Provider Options: 'twilio', 'http' (generic gateway), or 'mock' (dev console)
SMS_PROVIDER=mock

# Twilio SMS Credentials (When SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Generic HTTP SMS Gateway (When SMS_PROVIDER=http)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Redis Cache (Optional for cluster sessions)
REDIS_URL=redis://localhost:6379

# Uploads Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=mkd-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
